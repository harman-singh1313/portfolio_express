<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Template Email</title>
    <script src="https://kit.fontawesome.com/ac958ce66c.js" crossorigin="anonymous"></script>

    <style>
        * {
            padding: 0%;
            margin: 0%;
            box-sizing: border-box;
            font-family: sans-serif;
        }

        .main_view {
            padding: 40px 0 220px 20px;
            background-image: url(https://i.pinimg.com/736x/42/cd/c5/42cdc5155cfe5476e9b19d0384412719.jpg);
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
            width: 100%;
            height: 100%;
            margin-bottom: 20px;
        }

        .main_view h1 {
            font-size: 30px;
            color: rgb(56, 56, 56);
            text-shadow: 1px 1px 2px grey;
        }


        .icon {
            text-align: center;
            margin-top: 100px;
        }

        .icon img {

            width: 200px;
            height: 200px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 0 50px rgb(79, 79, 79);
            margin-bottom: 30px;
        }

        .welcome {
            margin-top: 100px;
            text-align: center;
        }

        .welcome h2 {
            font-size: 50px;
            color: rgb(199, 198, 198);
        }

        .about_page {
            display: flex;
            justify-content: space-between;
        }

        .form_img {
            background-image: url(https://i.pinimg.com/736x/a8/a6/04/a8a60441982cf3c0b787ffd24ec2f1b9.jpg);
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            width: 55%;
            /* height: 500px; */

        }

        .about_seciton {
            background-color: rgb(223, 223, 223);
            color: rgb(40, 40, 40);
            padding: 15px;
            margin-bottom: 60px;
            font-size: 30px;
        }

        .about_seciton h3 {
            font-size: 25px;
        }

        .details {
            width: 45%;
        }

        .user_detils {
            padding: 20px;
            margin-left: 50px;
            background-color: rgb(228, 255, 255);
        }

        .user_detils a {
            text-decoration: none;
            font-style: oblique;
        }

        .details h3 {
            padding: 7px 0 15px 0;
        }

        .skills {
            margin-bottom: 20px;
        }

        .skills td,
        table {
            color: rgb(54, 54, 54);
            border: 2px solid rgb(220, 192, 226);
            border-collapse: collapse;
            width: 400px;
            padding: 8px;

        }

        .skills th {
            border: 2px solid rgb(220, 192, 226);
            padding: 8px;

            background-color: rgb(255, 240, 255);

        }

        .skill_base {
            display: flex;
            justify-content: space-around;
            align-items: center;
            flex-wrap: wrap;
